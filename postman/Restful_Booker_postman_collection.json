                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// Получаем имя текущего тест-кейса из файла данных\r",
                      "const testName = pm.iterationData.get(\"testCaseName\") || \"Тест поля\";\r",
                      "\r",
                      "// Проверяем идеальное поведение (каждый кривой запрос ДОЛЖЕН возвращать 400)\r",
                      "pm.test(`Кейс: [${testName}] -> Бэкенд должен отклонять невалидные данные кодом 400`, function () {\r",
                      "    pm.response.to.have.status(400);\r",
                      "});\r",
                      "\r",
                      "// Ловушка для багов типа \"Падение сервера (500)\"\r",
                      "if (pm.response.code === 500) {\r",
                      "    pm.test(`КРИТИЧЕСКИЙ БАГ: Сервер упал в 500 ошибку на кейсе: ${testName}`, function () {\r",
                      "        pm.expect.fail(\"Необработанное исключение (Crash) на бэкенде вместо корректной ошибки 400.\");\r",
                      "    });\r",
                      "}\r",
                      "\r",
                      "// Ловушка для багов типа \"Пропуск невалидных данных (200)\"\r",
                      "if (pm.response.code === 200) {\r",
                      "    pm.test(`КРИТИЧЕСКИЙ БАГ: Сервер сохранил невалидные данные и вернул 200 OK в кейсе: ${testName}`, function () {\r",
