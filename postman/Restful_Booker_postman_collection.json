        {
          "name": "CreateToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Проверяем, что сервер ответил кодом 200 OK\r",
                  "pm.test(\"Статус ответа 200 OK\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Проверяем структуру ответа и тип данных токена\r",
                  "pm.test(\"Ответ содержит валидный строковый токен\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.be.an('object');\r",
                  "    pm.expect(jsonData).to.have.property('token');\r",
                  "    pm.expect(jsonData.token).to.be.a('string');\r",
                  "});\r",
                  "\r",
                  "// Автоматическое сохранение токена в окружение Postman\r",
                  "const response = pm.response.json();\r",
                  "if (response.token) {\r",
                  "    pm.environment.set(\"token\", response.token);\r",
                  "    console.log(\"Токен успешно обновлен в окружении: \" + response.token);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
